# ── Discord ──────────────────────────────────────────────────────────────
# https://discord.com/developers/applications → Bot → Token
#
# Use a DEDICATED application for the relay. Sharing one with another bot
# that also registers a global /telegram means whichever boots first wins
# and the other silently skips registering — no error, no log.
#
# The bot needs the MESSAGE CONTENT intent enabled on that page, or it will
# see every bridged message as empty.
DISCORD_TOKEN=

# Optional. If set, the bot DMs this user when the Telegram side fails to
# start, instead of only writing it to the log.
DISCORD_OWNER_ID=

# ── Telegram ─────────────────────────────────────────────────────────────
# Talk to @BotFather → /newbot, then copy the token it gives you.
#
# Two settings on the bot matter for a bridge:
#
#   /setprivacy → Disable
#       Privacy mode is ON by default, and a bot with it on only receives
#       commands and replies aimed at it — every ordinary group message is
#       invisible to it, so the bridge relays nothing. This is the single
#       most common reason a new bridge looks dead in one direction.
#
#   Add the bot to the group, and promote it if you want /telegram pin,
#       ban, or invite-link to work. Reading and sending need no rank.
TELEGRAM_TOKEN=

# Optional. A Windows PHP build usually ships without a CA bundle, so TLS to
# api.telegram.org fails with "unable to get local issuer certificate".
# Point this at a cacert.pem to fix it. Ignored when empty.
TELEGRAM_CA_BUNDLE=

# Optional. Point the bridge at a local Bot API server, which raises the
# upload limit and lets it download files larger than 20 MB.
# https://core.telegram.org/bots/api#using-a-local-bot-api-server
TELEGRAM_BASE_URL=

# debug | info | notice | warning | error
LOG_LEVEL=info
